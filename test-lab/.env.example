# Copy to `.env` and adjust for your machine.
#
# TESTLAB_DATA: host path for the heavy Jellyfin data (config DB, cache, staged
# plugin). Pick a drive with several GB free; an SSD makes the lab snappy.
# If you leave this unset, it defaults to ./data (next to this compose file).
#
#   Linux/macOS example:   TESTLAB_DATA=/srv/jellyfin-testlab/data
#   Windows example:       TESTLAB_DATA=G:/jellyfin-testlab/data
TESTLAB_DATA=./data
